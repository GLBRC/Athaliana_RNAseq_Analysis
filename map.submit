executable = map.sh
arguments  = /mnt/bigdata/linuxhome/mplace/data/RNA-seq/sang_jin_kim/Analysis/trim $(sample_name) /home/glbrc.org/mplace/data/RNA-seq/sang_jin_kim/Analysis /mnt/bigdata/linuxhome/mplace/data/RNA-seq/sang_jin_kim/Reference/Athaliana_167/Athaliana_167_index Athaliana_167_fa  Athaliana_167_gene
